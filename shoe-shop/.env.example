# Copy to .env.local and fill in only the providers you use. Leave all of them empty
# to use the mock test-card provider. Never commit real keys.

# Optional: "stripe" or "paypal". Used when more than one provider has a key set.
VITE_PAYMENT_PROVIDER=

# Stripe is switched on when this is set (a publishable key, pk_test_... or pk_live_...).
VITE_STRIPE_PUBLISHABLE_KEY=

# PayPal is switched on when this is set (the client ID).
VITE_PAYPAL_CLIENT_ID=
