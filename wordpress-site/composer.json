{
    "name": "ninja/wordpress-site",
    "description": "WordPress site with the ninja-theme and ninja-hello plugin. Tests run without a WordPress install.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "johnpbloch/wordpress-core": "^6.8",
        "aaemnnosttv/wp-sqlite-db": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "NinjaHello\\": "wp-content/plugins/ninja-hello/includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NinjaHello\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "wordpress-install-dir": "wordpress",
        "installer-paths": {
            "vendor/{$vendor}/{$name}/": ["type:wordpress-dropin"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "johnpbloch/wordpress-core-installer": true,
            "composer/installers": true
        }
    }
}
