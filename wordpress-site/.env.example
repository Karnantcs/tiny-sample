# Copy this file to .env and replace every value with your own.
# Do not commit .env; it is listed in .gitignore.

# Port on your machine that serves WordPress (http://localhost:8080)
WP_PORT=8080

# Database settings used by MySQL and by WordPress
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Set to 1 to show PHP debug output in WordPress (local development only)
WORDPRESS_DEBUG=0
